# ─────────────────────────────────────────────────────────────
# DATABASE  — pilih SALAH SATU cara:
#
# A) Lokal (field terpisah)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portofolio
DB_USER=your_pg_user
DB_PASSWORD=
# "true" kalau Postgres cloud yang butuh SSL (Supabase / Neon / Render / Railway)
DB_SSL=false
#
# B) Produksi (satu connection string). Kalau DATABASE_URL di-set,
#    field DB_* di atas diabaikan. Untuk serverless pakai pooler port 6543.
# DATABASE_URL=postgresql://user:password@host:6543/postgres
# ─────────────────────────────────────────────────────────────

# AUTH
# JWT_SECRET: string acak, jangan diubah setelah dipakai.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SERVER
# PORT: samakan dengan VITE_API_URL di frontend. Di Vercel JANGAN di-set (otomatis).
PORT=3001
# FRONTEND_URL: dipakai untuk CORS. Produksi = URL frontend (mis. https://xxx.vercel.app)
FRONTEND_URL=http://localhost:5173

# SUPABASE STORAGE  — tempat menyimpan file upload (gambar & PDF)
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings → API Keys → Secret key (sb_secret_...) atau legacy service_role (eyJ...)
SUPABASE_SECRET_KEY=
# Nama bucket PUBLIC di Supabase Storage
SUPABASE_BUCKET=uploads

# ADMIN  — dipakai sekali oleh: npm run seed:admin
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
